<launch>
    
    <node pkg="rplidar_ros" type="rplidarNode" name="rplidar" output="screen"/>
    
    <node pkg="map_server" type="map_server" name="map_server" args="$(find bot)/maps/my_map.yaml"/>
    
    <node pkg="tf" type="static_transform_publisher" name="static_tf"
          args="0 0 0 0 0 0 base_link laser 10"/>
    
    <node pkg="amcl" type="amcl" name="amcl"/>
    
    <include file="$(find navigation)/launch/navigation_hector.launch"/>
    
    <node pkg="rviz" type="rviz" name="rviz"/>
    
    <node pkg="motor_control" type="motor.py" name="motor_control" output="screen" launch-prefix="python3"/>
</launch>
