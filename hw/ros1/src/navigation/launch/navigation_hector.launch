<launch>
  
  <!-- AMCL for Localization -->
 <!-- <node pkg="amcl" type="amcl" name="amcl" output="screen">-->
   <!-- <rosparam file="$(find navigation)/config/amcl_params_original.yaml" />-->
  <!--</node>-->

  <!-- Move Base -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <param name="base_global_planner" value="navfn/NavfnROS" />
    <!--<param name="base_global_planner" value="global_planner/GlobalPlanner" />-->
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>
   
    <rosparam file="$(find navigation)/config/global_planner_params.yaml" />
    <rosparam file="$(find navigation)/config/local_planner_params.yaml" />
    <rosparam file="$(find navigation)/config/global_costmap_params.yaml" />
    <rosparam file="$(find navigation)/config/local_costmap_params.yaml" />
  </node>

</launch>
